# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (portfolio: akhmadikbal.web.id)
# Salin file ini menjadi `.env.local` untuk development lokal,
# dan daftarkan key ini di Vercel Project Settings > Environment Variables.
# ==============================================================================

# --- EMAIL PROVIDER (Resend) ---
# Daftar akun di https://resend.com, generate API Key pada menu "API Keys"
RESEND_API_KEY=re_your_resend_api_key_here
# Alamat pengirim: Gunakan 'Portfolio Contact <onboarding@resend.dev>' untuk default gratis
# Atau 'Contact <contact@akhmadikbal.web.id>' jika domain sudah diverifikasi di Resend
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
# Alamat penerima pesan kontak masuk (email pribadi Anda)
CONTACT_TO_EMAIL=akhmadikbalkhoir@gmail.com

# --- CLOUDFLARE TURNSTILE (Anti-Bot / Captcha Pengganti) ---
# Buat widget di https://dash.cloudflare.com -> Turnstile -> Add Site
# Daftarkan hostname: akhmadikbal.web.id, ahmdikball.vercel.app, localhost
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx_site_key_here
TURNSTILE_SECRET_KEY=0x4AAAAAAAx_secret_key_here

# --- UPSTASH REDIS (Distributed Rate Limiting untuk Vercel Serverless) ---
# Buat database serverless Redis gratis di https://console.upstash.com
# Salin dari tab Details -> REST API
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# --- SUPABASE (Database Reaksi & Komentar Real-time) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
